TELEGRAM_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_THREAD_ID=

# Hourly/daily commit digest (`local-gitlab-rss digest run`)
# GITLAB_URL=https://gitlab.example.com
# GITLAB_TOKEN=          # access token with read_api scope
# GITLAB_GROUP=          # group path or id, e.g. my-group
# GITLAB_PROJECTS=       # optional: only these project paths, e.g. backend,frontend
# DIGEST_UTC_OFFSET=5    # local time zone, whole hours
# DIGEST_TITLES=3        # commit titles per person
# DIGEST_TITLE_LEN=60
# DIGEST_EXCLUDE=        # regex on author name/e-mail to skip, e.g. ^Deployment Bot$
